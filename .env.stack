# Local stack (docker compose + mock DTB). Committed on purpose: every value is
# local-only and safe to share. Used by `npm run dev:stack`, `db:*` scripts.
APP_ENV=local
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:rwtw@localhost:54329/rwtw_dev

# URLs
APP_URL=http://localhost:4000
BASE_URL=http://localhost:4000
WEBSITE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# Event switches
REGISTRATION_OPEN=true
RAFFLE_OPEN=true
EVENT_NAME=Ride With The Warriors 2027
EVENT_DATE=2027-06-27
EVENT_TIME=6:00 AM
EVENT_LOCATION=Nairobi

# Email → Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit has no TLS
SMTP_IGNORE_TLS=true
SMTP_USER=local
SMTP_PASS=local
EMAIL_FROM="Ride With The Warriors <noreply@rwtw.local>"
SUPPORT_EMAIL=support@rwtw.local
ALERT_EMAIL=alerts@rwtw.local

# SMS → Mailpit as emails to sms+<number>@sms.local
SMS_DRIVER=mailpit

# Payments → Safaricom Daraja sandbox (a real prompt on your phone, sandbox money).
# Put DARAJA_CONSUMER_KEY / DARAJA_CONSUMER_SECRET in .env.stack.local (gitignored).
# DARAJA_POLL asks Daraja for the result, so no public callback URL is needed.
# Sandbox prompts charge KES 1 unless SANDBOX_STK_AMOUNT is set ("actual" = real amount).
# `npm run dev:stack:mock` uses the mock DTB below instead (offline; dashboard :4010).
PAYMENT_MODE=live
PAYMENT_PROVIDER=sandbox
DARAJA_POLL=true
DTB_AUTH_URL=http://localhost:4010/auth/token
DTB_STK_PUSH_URL=http://localhost:4010/stkpush
DTB_STATUS_URL=http://localhost:4010/transactionstatus
DTB_BASE_URL=http://localhost:4010
DTB_CLIENT_ID=local
DTB_CLIENT_SECRET=local
DTB_USERNAME=local
DTB_PASSWORD=local
DTB_BUSINESS_SHORTCODE=000000
DTB_ACCOUNT_NUMBER=0000000000
DTB_PROMPT_ACCOUNT=RWTW-LOCAL
DTB_CALLBACK_SECRET=local-callback-secret-0123456789abcdef
OTP_PEPPER=local-otp-pepper-0123456789abcdef0123

# Login codes also appear in API responses (never in production)
OTP_DEV_ECHO=true

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/*
CRON_SECRET=local-cron-secret-0123456789abcdef012

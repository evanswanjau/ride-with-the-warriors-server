# Test suite: Docker Postgres from docker-compose.yml (database rwtw_test).
# Tests delete data and refuse to run against non-local hosts.
APP_ENV=test
NODE_ENV=test
DATABASE_URL=postgresql://postgres:rwtw@localhost:54329/rwtw_test
DTB_CALLBACK_SECRET=test-callback-secret-0123456789abcdef
OTP_PEPPER=test-otp-pepper-0123456789abcdef0123
APP_URL=http://localhost:4000
REGISTRATION_OPEN=true
RAFFLE_OPEN=true
MESSAGING_DISABLED=true
OTP_DEV_ECHO=true
PAYMENT_MODE=live
DTB_CLIENT_ID=test
DTB_CLIENT_SECRET=test

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/*
CRON_SECRET=test-cron-secret-0123456789abcdef0123

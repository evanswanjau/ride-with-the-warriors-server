generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id              String             @id
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  circuitId       String
  type            String
  status          RegistrationStatus @default(UNPAID)
  firstName       String
  lastName        String
  email           String?
  phoneNumber     String?
  idNumber        String?
  dob             String?
  gender          String?
  groupId         String?
  teamName        String?
  isCaptain       Boolean            @default(false)
  guardianName    String?
  emergencyPhone  String?
  emergencyContactName String?
  relationship    String?
  tshirtSize      String?
  category        String?
  totalAmount     Float              @default(0)
  mpesaCode       String?
  isMilitary      Boolean            @default(false)
  serviceNumber   String?
  rank            String?
  service         String?
  unit            String?
  payload         Json?
  pricing         Json?
  classifications Json?

  @@index([groupId])
  @@index([email])
  @@index([phoneNumber])
}

model Admin {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("admin")
  createdAt    DateTime       @default(now())
  lastLogin    DateTime?
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

enum RegistrationStatus {
  UNPAID
  PAID
  CONFIRMED
  CANCELLED
}

model Payment {
  id                  String   @id @default(uuid())
  registrationId      String
  checkoutRequestId   String?  @unique
  merchantRequestId   String?
  phone               String?
  amount              Float
  status              String   @default("PENDING") // PENDING, PAID, FAILED
  failureReason       String?
  mpesaReceiptNumber  String?
  transactionDate     String?  // as returned by M-Pesa e.g. "20231201120000"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([registrationId])
  @@index([checkoutRequestId])
}

model PricingCategory {
  id             String   @id @default(uuid())
  circuitId      String // e.g., 'blitz', 'recon', 'corporate', 'family'
  type           String // 'individual', 'team', or 'family'
  familyCategory String? // 'cubs', 'champs', 'tigers'
  minAge         Int? // inclusive
  maxAge         Int? // inclusive
  categoryName   String
  regRange       String
  price          Float
  colorCode      String
  hexColor       String
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([circuitId, type, categoryName, familyCategory])
  @@index([circuitId, type])
}

model EmailLog {
  id             String   @id @default(uuid())
  registrationId String
  type           String   // 'confirmation', 'payment_reminder_3d', 'payment_reminder_7d', 'reminder_7d', 'reminder_1d', 'reminder_day'
  sentAt         DateTime @default(now())
  status         String   // 'sent', 'failed'
  error          String?

  @@index([registrationId, type])
  @@index([type, status])
}

model RaffleTicket {
  id                String   @id          // e.g. "AA001"
  firstName         String
  lastName          String
  email             String
  phoneNumber       String?
  idNumber          String?
  gender            String?
  status            String   @default("UNPAID")  // UNPAID → PAID
  failureReason     String?
  checkoutRequestId String?
  paymentFailed     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
}

model Donation {
  id                String   @id @default(uuid())
  amount            Float
  name              String?
  email             String?
  phone             String?
  status            String   @default("PENDING") // PENDING, PAID, FAILED
  failureReason     String?
  checkoutRequestId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([checkoutRequestId])
}

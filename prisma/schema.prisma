generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id                   String             @id
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  circuitId            String
  type                 String
  status               RegistrationStatus @default(UNPAID)
  firstName            String
  lastName             String
  email                String?
  phoneNumber          String?
  idNumber             String?
  dob                  String?
  gender               String?
  groupId              String?
  teamName             String?
  isCaptain            Boolean            @default(false)
  guardianName         String?
  emergencyPhone       String?
  relationship         String?
  category             String?
  totalAmount          Float              @default(0)
  payload              Json?
  pricing              Json?
  classifications      Json?
  emergencyContactName String?
  tshirtSize           String?
  mpesaCode            String?
  isMilitary           Boolean            @default(false)
  rank                 String?
  service              String?
  serviceNumber        String?
  unit                 String?

  @@index([groupId])
  @@index([email])
  @@index([phoneNumber])
}

model Admin {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("admin")
  createdAt    DateTime       @default(now())
  lastLogin    DateTime?
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Payment {
  id                 String   @id @default(uuid())
  registrationId     String
  checkoutRequestId  String?  @unique
  merchantRequestId  String?
  phone              String?
  amount             Float
  status             String   @default("PENDING")
  failureReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  mpesaReceiptNumber String?
  transactionDate    String?

  @@index([registrationId])
  @@index([checkoutRequestId])
}

model PricingCategory {
  id             String   @id @default(uuid())
  circuitId      String
  type           String
  familyCategory String?
  minAge         Int?
  maxAge         Int?
  categoryName   String
  regRange       String
  price          Float
  colorCode      String
  hexColor       String
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([circuitId, type, categoryName, familyCategory])
  @@index([circuitId, type])
}

model EmailLog {
  id             String   @id @default(uuid())
  registrationId String
  type           String
  sentAt         DateTime @default(now())
  status         String
  error          String?

  @@index([registrationId, type])
  @@index([type, status])
}

model RaffleTicket {
  id                String   @id
  firstName         String
  lastName          String
  email             String
  phoneNumber       String?
  status            String   @default("UNPAID")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  checkoutRequestId String?
  paymentFailed     Boolean  @default(false)
  gender            String?
  idNumber          String?
  failureReason     String?

  @@index([email])
}

model Donation {
  id                String   @id @default(uuid())
  amount            Float
  name              String?
  email             String?
  phone             String?
  status            String   @default("PENDING")
  checkoutRequestId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  failureReason     String?

  @@index([email])
  @@index([checkoutRequestId])
}

enum RegistrationStatus {
  UNPAID
  PAID
  CONFIRMED
  CANCELLED
}

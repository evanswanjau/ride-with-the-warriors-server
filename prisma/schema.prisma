generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id              String             @id
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  circuitId       String
  type            String
  status          RegistrationStatus @default(UNPAID)
  firstName       String
  lastName        String
  email           String?
  phoneNumber     String?
  idNumber        String?
  dob             String?
  gender          String?
  groupId         String?
  teamName        String?
  isCaptain       Boolean            @default(false)
  guardianName    String?
  emergencyPhone  String?
  relationship    String?
  category        String?
  totalAmount     Float              @default(0)
  payload         Json?
  pricing         Json?
  classifications Json?

  @@index([groupId])
  @@index([email])
  @@index([phoneNumber])
}

model Admin {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("admin")
  createdAt    DateTime       @default(now())
  lastLogin    DateTime?
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

enum RegistrationStatus {
  UNPAID
  PAID
  CONFIRMED
  CANCELLED
}

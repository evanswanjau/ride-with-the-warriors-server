generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id                   String             @id
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  circuitId            String
  type                 String
  status               RegistrationStatus @default(UNPAID)
  firstName            String
  lastName             String
  email                String?
  phoneNumber          String?
  idNumber             String?
  dob                  String?
  gender               String?
  groupId              String?
  teamName             String?
  isCaptain            Boolean            @default(false)
  guardianName         String?
  emergencyPhone       String?
  relationship         String?
  category             String?
  totalAmount          Float              @default(0)
  payload              Json?
  pricing              Json?
  classifications      Json?
  emergencyContactName String?
  tshirtSize           String?
  mpesaCode            String?
  isMilitary           Boolean            @default(false)
  rank                 String?
  service              String?
  serviceNumber        String?
  unit                 String?
  bikeHire             BikeHire?
  // Assigned only once the registration is paid (or made complementary).
  bibNumber            String?            @unique
  eventYear            Int                @default(2026)
  // Account that registered and pays for this row (guardian / team captain / rider).
  accountId            String?
  account              Account?           @relation("RegistrationOwner", fields: [accountId], references: [id], onDelete: SetNull)
  // The rider's own account, when it differs from the owner (team members, adult family riders).
  participantAccountId String?
  participantAccount   Account?           @relation("RegistrationParticipant", fields: [participantAccountId], references: [id], onDelete: SetNull)
  // Set when an admin cancels the registration (rows are kept, never deleted).
  cancelledAt          DateTime?
  cancelledBy          String?

  @@index([groupId])
  @@index([email])
  @@index([phoneNumber])
  @@index([accountId])
  @@index([participantAccountId])
  @@index([eventYear])
}

model Admin {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  // viewer (read only) | admin (read and change) | super_admin (also deletes and bulk messages).
  role         String         @default("admin")
  createdAt    DateTime       @default(now())
  lastLogin    DateTime?
  sessions     AdminSession[]
}

// One row per admin change (every successful non-GET admin request, plus data repair scripts),
// and per participant change to their own account or riders (actorType "account").
// adminEmail is copied so the row stays readable if the admin is deleted; for account rows it
// holds the account's email or phone at the time.
model AdminAuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  // admin | account
  actorType  String   @default("admin")
  adminId    String?
  accountId  String?
  adminEmail String
  action     String // e.g. "PATCH /api/v1/admin/registrations/:id" or "script:repair-paid-registrations"
  entityId   String?
  status     Int?
  ip         String?
  details    Json?

  @@index([createdAt])
  @@index([adminId])
  @@index([accountId])
  @@index([entityId])
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Payment {
  id                 String   @id @default(uuid())
  // REGISTRATION | RAFFLE | DONATION | BIKE_HIRE. Every M-Pesa prompt is one row; callbacks
  // are matched on checkoutRequestId here, never on the item's own column.
  purpose            String?
  registrationId     String?
  raffleTicketIds    String[] // New: store array of ticket IDs for bulk payments
  donationId         String? // New: link to donation
  checkoutRequestId  String?  @unique
  merchantRequestId  String?
  phone              String?
  amount             Float
  // PENDING -> PAID | FAILED | EXPIRED | FLAGGED. A success also settles FAILED/EXPIRED (money
  // was taken); a failure only settles PENDING. A success whose amount or phone does not match
  // makes it FLAGGED, which only an admin can settle. See src/services/payments.ts.
  status             String   @default("PENDING")
  failureReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  mpesaReceiptNumber String?
  transactionDate    String?
  mnoReference       String? // New: generic bank reference
  cbsReference       String? // New: core banking system reference
  paymentDetails     Json? // New: store full callback payload
  bikeHireId         String? // Payment for a bike hire added after registration
  // Reconciliation (src/services/reconciliation.ts): when the gateway was last asked about this
  // payment, how often, and what it said (PAID | FAILED | PENDING | UNKNOWN | ERROR: ...).
  lastCheckedAt      DateTime?
  checkCount         Int      @default(0)
  lastCheckResult    String?
  // Set when a success callback did not match this payment (src/services/payments.ts);
  // status is then FLAGGED until an admin accepts or rejects it.
  flaggedAt          DateTime?
  flagReason         String?

  @@index([registrationId])
  @@index([checkoutRequestId])
  @@index([donationId])
  @@index([bikeHireId])
  @@index([status, createdAt])
}

model PricingCategory {
  id             String   @id @default(uuid())
  circuitId      String
  type           String
  familyCategory String?
  minAge         Int?
  maxAge         Int?
  categoryName   String
  regRange       String
  price          Float
  colorCode      String
  hexColor       String
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([circuitId, type, categoryName, familyCategory])
  @@index([circuitId, type])
}

model EmailLog {
  id             String   @id @default(uuid())
  registrationId String
  type           String
  sentAt         DateTime @default(now())
  status         String
  error          String?

  @@index([registrationId, type])
  @@index([type, status])
}

model RaffleTicket {
  id                String   @id
  firstName         String
  lastName          String
  email             String
  phoneNumber       String?
  status            String   @default("UNPAID")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  checkoutRequestId String?
  paymentFailed     Boolean  @default(false)
  gender            String?
  idNumber          String?
  failureReason     String?
  mpesaCode         String? // New: store Receipt Number directly
  paymentDetails    Json? // New: store full callback payload
  referralCode      String? // Referral code used at purchase
  // Assigned only once the ticket is paid.
  ticketNumber      String?  @unique
  eventYear         Int      @default(2026)
  accountId         String?
  account           Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([referralCode])
  @@index([accountId])
}

model Referral {
  id              String   @id @default(uuid())
  code            String   @unique
  influencerName  String
  influencerEmail String?
  influencerPhone String?
  isActive        Boolean  @default(true)
  clicks          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
}

model Donation {
  id                String   @id @default(uuid())
  amount            Float
  name              String?
  email             String?
  phone             String?
  status            String   @default("PENDING")
  checkoutRequestId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  failureReason     String?
  mpesaCode         String? // New
  paymentDetails    Json? // New
  eventYear         Int      @default(2026)
  // Optional: donations can be anonymous.
  accountId         String?
  account           Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([checkoutRequestId])
  @@index([accountId])
}

enum RegistrationStatus {
  UNPAID
  PAID
  CONFIRMED
  COMPLEMENTARY
  CANCELLED
}

model SmsLog {
  id          String   @id @default(uuid())
  phoneNumber String
  message     String
  status      String
  messageId   String?
  cost        String?
  sentAt      DateTime @default(now())

  @@index([phoneNumber])
  @@index([status])
}

model ShortLink {
  id        String   @id // The short ID
  url       String // original URL
  createdAt DateTime @default(now())
  clicks    Int      @default(0)

  @@index([id])
}

model BikeHire {
  id                String       @id @default(uuid())
  registrationId    String       @unique
  registration      Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  bikeType          String       @default("Standard")
  status            String       @default("PENDING") // PENDING, PAID, COLLECTED, RETURNED
  amount            Float        @default(1500)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  checkoutRequestId String?      @unique
  eventYear         Int          @default(2026)
  accountId         String?
  account           Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([accountId])
}

model NotifyInterest {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String?
  createdAt DateTime @default(now())

  @@index([email])
}

model EventFeedback {
  id           String   @id @default(uuid())
  role         String // CYCLIST | ATTENDEE | SPONSOR | ORGANISER
  rating       Int // 1-5 overall experience
  firstName    String?
  lastName     String?
  highlights   String? // what went well
  improvements String? // what to improve
  createdAt    DateTime @default(now())

  @@index([role])
  @@index([createdAt])
}

// ─── Participant accounts (passwordless, OTP login) ─────────────────────────

model Account {
  id             String         @id @default(uuid())
  firstName      String
  lastName       String
  // Normalised: lowercase email, phone as 2547XXXXXXXX / 2541XXXXXXXX. At least one is set.
  email          String?        @unique
  phone          String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastLoginAt    DateTime?
  sessions       UserSession[]
  registrations  Registration[] @relation("RegistrationOwner")
  participations Registration[] @relation("RegistrationParticipant")
  raffleTickets  RaffleTicket[]
  donations      Donation[]
  bikeHires      BikeHire[]
}

model OtpCode {
  id          String    @id @default(uuid())
  channel     String // EMAIL | SMS
  destination String // normalised email or phone
  purpose     String // LOGIN | SIGNUP | ADD_CONTACT | CHANGE_CONTACT
  codeHash    String
  // Signup details or the account adding a contact, carried until verification.
  context     Json?
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([destination, createdAt])
}

model UserSession {
  id        String   @id @default(uuid())
  accountId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ─── Gallery (Cloudinary-hosted) ──────────────────────────────────────────────

model GalleryPhoto {
  id          String   @id @default(uuid())
  eventYear   Int
  album       String
  publicId    String   @unique // Cloudinary public_id
  width       Int
  height      Int
  caption     String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([eventYear, album, sortOrder])
}

// Outbox for every email and SMS (see src/services/outbox.ts). Senders insert a row; the worker
// (/api/cron/notifications, every minute) sends it, retrying with backoff. dedupeKey is unique,
// so the same confirmation can never be queued twice. Login codes are sent at once and stored
// here without the code.
model Notification {
  id            String    @id @default(uuid())
  // EMAIL | SMS
  channel       String
  recipient     String
  // e.g. "email:confirmation", "sms:payment-confirmed", "otp"
  template      String
  // The rendered message (email: from/to/subject/html/text/attachments; SMS: { message }),
  // or the data a template renderer needs (see RENDERERS in outbox.ts).
  payload       Json
  dedupeKey     String    @unique
  // PENDING -> SENDING -> SENT | FAILED (gave up) | SUPPRESSED (MESSAGING_DISABLED)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?
  // Extra bookkeeping, e.g. { emailLog: { registrationId, type } } for the admin email history
  meta          Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([recipient])
}

// One row per reconciliation run (src/services/reconciliation.ts), shown to admins.
model ReconciliationRun {
  id           String    @id @default(uuid())
  // cron | admin:<email> | script
  trigger      String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  checked      Int       @default(0)
  paid         Int       @default(0)
  failed       Int       @default(0)
  stillPending Int       @default(0)
  errors       Int       @default(0)
  expired      Int       @default(0)
  // Per payment: [{ paymentId, ref, result, settle, error? }]
  details      Json?

  @@index([startedAt])
}

// A payment callback (or status answer) that did not match its Payment: wrong amount or phone.
// Never paid automatically; an admin accepts or rejects it (POST /api/v1/admin/payments/:id/resolve).
model PaymentFlag {
  id         String    @id @default(uuid())
  paymentId  String
  createdAt  DateTime  @default(now())
  // callback | reconciliation
  source     String
  // AMOUNT_MISMATCH | PHONE_MISMATCH (comma-separated when both)
  kind       String
  expected   Json
  received   Json
  // What the payment's status was when the callback arrived
  statusWas  String
  details    Json?
  resolvedAt DateTime?
  resolvedBy String?
  // ACCEPTED | REJECTED | SUPERSEDED (the payment was settled some other way)
  resolution String?
  note       String?

  @@index([paymentId])
  @@index([resolvedAt])
}

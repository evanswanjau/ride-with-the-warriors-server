# E2E stack (Playwright): own database, API on :4100, mock DTB on :4110.
# Committed on purpose: local-only values.
APP_ENV=local
NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://postgres:rwtw@localhost:54329/rwtw_e2e

# URLs
APP_URL=http://localhost:4100
BASE_URL=http://localhost:4100
WEBSITE_URL=http://localhost:5174
SITE_URL=http://localhost:5174

# Event switches
REGISTRATION_OPEN=true
RAFFLE_OPEN=true
EVENT_NAME=Ride With The Warriors 2027
EVENT_DATE=2027-06-27
EVENT_TIME=6:00 AM
EVENT_LOCATION=Nairobi

# Email → Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=local
SMTP_PASS=local
EMAIL_FROM="Ride With The Warriors <noreply@rwtw.local>"
SUPPORT_EMAIL=support@rwtw.local
ALERT_EMAIL=alerts@rwtw.local

# SMS → Mailpit as emails to sms+<number>@sms.local
SMS_DRIVER=mailpit

# Payments → mock DTB (npm run mock:dtb, dashboard http://localhost:4110)
PAYMENT_MODE=live
# E2E always uses the mock DTB, so results are predictable.
PAYMENT_PROVIDER=dtb
DTB_AUTH_URL=http://localhost:4110/auth/token
DTB_STK_PUSH_URL=http://localhost:4110/stkpush
DTB_BASE_URL=http://localhost:4110
DTB_CLIENT_ID=local
DTB_CLIENT_SECRET=local
DTB_USERNAME=local
DTB_PASSWORD=local
DTB_BUSINESS_SHORTCODE=000000
DTB_ACCOUNT_NUMBER=0000000000
DTB_PROMPT_ACCOUNT=RWTW-LOCAL
DTB_CALLBACK_SECRET=local-callback-secret-0123456789abcdef
OTP_PEPPER=local-otp-pepper-0123456789abcdef0123

# Login codes also appear in API responses (never in production)
OTP_DEV_ECHO=true

# Per-IP rate limits off (many logins from one machine)
RATE_LIMITS_DISABLED=true

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/*
CRON_SECRET=local-cron-secret-0123456789abcdef012

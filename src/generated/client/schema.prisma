generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id                   String             @id
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  circuitId            String
  type                 String
  status               RegistrationStatus @default(UNPAID)
  firstName            String
  lastName             String
  email                String?
  phoneNumber          String?
  idNumber             String?
  dob                  String?
  gender               String?
  groupId              String?
  teamName             String?
  isCaptain            Boolean            @default(false)
  guardianName         String?
  emergencyPhone       String?
  relationship         String?
  category             String?
  totalAmount          Float              @default(0)
  payload              Json?
  pricing              Json?
  classifications      Json?
  emergencyContactName String?
  tshirtSize           String?
  mpesaCode            String?
  isMilitary           Boolean            @default(false)
  rank                 String?
  service              String?
  serviceNumber        String?
  unit                 String?
  bikeHire             BikeHire?

  @@index([groupId])
  @@index([email])
  @@index([phoneNumber])
}

model Admin {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("admin")
  createdAt    DateTime       @default(now())
  lastLogin    DateTime?
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Payment {
  id                 String   @id @default(uuid())
  registrationId     String?
  raffleTicketIds    String[] // New: store array of ticket IDs for bulk payments
  donationId         String? // New: link to donation
  checkoutRequestId  String?  @unique
  merchantRequestId  String?
  phone              String?
  amount             Float
  status             String   @default("PENDING")
  failureReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  mpesaReceiptNumber String?
  transactionDate    String?
  mnoReference       String? // New: generic bank reference
  cbsReference       String? // New: core banking system reference
  paymentDetails     Json? // New: store full callback payload

  @@index([registrationId])
  @@index([checkoutRequestId])
  @@index([donationId])
}

model PricingCategory {
  id             String   @id @default(uuid())
  circuitId      String
  type           String
  familyCategory String?
  minAge         Int?
  maxAge         Int?
  categoryName   String
  regRange       String
  price          Float
  colorCode      String
  hexColor       String
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([circuitId, type, categoryName, familyCategory])
  @@index([circuitId, type])
}

model EmailLog {
  id             String   @id @default(uuid())
  registrationId String
  type           String
  sentAt         DateTime @default(now())
  status         String
  error          String?

  @@index([registrationId, type])
  @@index([type, status])
}

model RaffleTicket {
  id                String   @id
  firstName         String
  lastName          String
  email             String
  phoneNumber       String?
  status            String   @default("UNPAID")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  checkoutRequestId String?
  paymentFailed     Boolean  @default(false)
  gender            String?
  idNumber          String?
  failureReason     String?
  mpesaCode         String? // New: store Receipt Number directly
  paymentDetails    Json? // New: store full callback payload
  referralCode      String? // Referral code used at purchase

  @@index([email])
  @@index([referralCode])
}

model Referral {
  id              String   @id @default(uuid())
  code            String   @unique
  influencerName  String
  influencerEmail String?
  influencerPhone String?
  isActive        Boolean  @default(true)
  clicks          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
}

model Donation {
  id                String   @id @default(uuid())
  amount            Float
  name              String?
  email             String?
  phone             String?
  status            String   @default("PENDING")
  checkoutRequestId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  failureReason     String?
  mpesaCode         String? // New
  paymentDetails    Json? // New

  @@index([email])
  @@index([checkoutRequestId])
}

enum RegistrationStatus {
  UNPAID
  PAID
  CONFIRMED
  COMPLEMENTARY
  CANCELLED
}

model SmsLog {
  id          String   @id @default(uuid())
  phoneNumber String
  message     String
  status      String
  messageId   String?
  cost        String?
  sentAt      DateTime @default(now())

  @@index([phoneNumber])
  @@index([status])
}

model ShortLink {
  id        String   @id // The short ID
  url       String // original URL
  createdAt DateTime @default(now())
  clicks    Int      @default(0)

  @@index([id])
}

model BikeHire {
  id             String       @id @default(uuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  bikeType       String       @default("Standard")
  status         String       @default("PENDING") // PENDING, PAID, COLLECTED, RETURNED
  amount         Float        @default(1500)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([registrationId])
}

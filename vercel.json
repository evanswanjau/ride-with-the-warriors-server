{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/src/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/src/index.ts"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily",
            "schedule": "0 3 * * *"
        }
    ]
}

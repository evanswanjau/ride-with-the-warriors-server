# Every variable the API reads. Copy to the environment you deploy to.
# Local development needs none of this: use `npm run dev:stack` (.env.stack).
#
# APP_ENV decides which safety checks run at boot (src/config.ts):
#   local | test | uat | production
# In uat and production the server refuses to start without DTB_CALLBACK_SECRET
# and OTP_PEPPER (32+ chars). In production it also refuses PAYMENT_MODE=simulate,
# DTB_INSECURE=true, OTP_DEV_ECHO=true and MESSAGING_DISABLED=true.
APP_ENV=production
NODE_ENV=production
PORT=4000

# Database (Supabase). Use the pooler URL.
DATABASE_URL=

# Public URLs
APP_URL=                 # this API, e.g. https://api.example.com (DTB callbacks go here)
BASE_URL=                # legacy alias of APP_URL
WEBSITE_URL=             # the client site, used in email links
SITE_URL=                # the client site, used on bibs (QR codes)

# Event
REGISTRATION_OPEN=       # "true" to open registration
RAFFLE_OPEN=             # "true" to open the raffle
EVENT_NAME=
EVENT_DATE=
EVENT_TIME=
EVENT_LOCATION=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SUPPORT_EMAIL=
ALERT_EMAIL=
ALERT_PHONE=

# SMS: textsms (real) or mailpit (local only)
SMS_DRIVER=textsms
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=

# Payments (DTB Fiorano). PAYMENT_MODE=simulate marks payments paid without DTB (local only).
PAYMENT_MODE=live
DTB_BASE_URL=
DTB_AUTH_URL=
DTB_STK_PUSH_URL=
DTB_CLIENT_ID=
DTB_CLIENT_SECRET=
DTB_USERNAME=
DTB_PASSWORD=
DTB_BUSINESS_SHORTCODE=
DTB_ACCOUNT_NUMBER=
DTB_PASS_KEY=
DTB_PROMPT_ACCOUNT=
DTB_CALLBACK_SECRET=     # required outside local/test; 32+ random chars
DTB_INSECURE=            # never "true" in production

# Login codes
OTP_PEPPER=              # required outside local/test; 32+ random chars
OTP_DEV_ECHO=            # local/test only

# Kill switch for all email/SMS (copies of production data)
MESSAGING_DISABLED=

# Gallery
CLOUDINARY_URL=

# Error tracking (optional)
SENTRY_DSN=

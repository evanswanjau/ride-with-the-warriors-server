{
  "name": "ride-with-the-warriors-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:dev": "tsx watch --env-file=.env.development src/index.ts",
    "dev:prod": "tsx watch --env-file=.env.production src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "resend-raffle-email": "tsx src/scripts/resendRaffleEmail.ts",
    "send-all-raffle-tickets": "tsx src/scripts/sendAllRaffleTickets.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "africastalking": "^0.6.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.18.0",
    "shorturly": "^1.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.18.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
